-- ~/.config/hyprmac/init.lua
-- hyprMac configuration. Everything is optional; delete a line to use the default.
-- Reload from the menu bar (hyprMac ▸ Reload Configuration) after editing.

config = {
    gaps = {
        inner = 8,   -- points between adjacent windows      (0 – 200)
        outer = 12,  -- points between windows and the edges (0 – 200)
    },
    split_ratio = 0.5, -- share of a split given to the existing window (0.1 – 0.9)
}
